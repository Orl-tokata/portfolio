# Copy to .env.local for local development. All values are public build-time settings.

# Public URL of this site — used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional form service endpoint (e.g. Formspree: https://formspree.io/f/xxxxxxx).
# Leave empty and the contact form opens the visitor's email app instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Override the GitHub username (defaults to profile.githubUsername: Orl-tokata).
NEXT_PUBLIC_GITHUB_USERNAME=

# Optional (build-time only, never shipped to the browser): enables the live
# contribution calendar via the GraphQL API and raises rate limits.
GITHUB_TOKEN=

# Set to "true" to always use sample GitHub data (e.g. offline builds).
GITHUB_DISABLE_FETCH=false
